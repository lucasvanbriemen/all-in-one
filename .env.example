# Copy to .env and fill in real values. The Rails app reads these via dotenv.
# Primary database (the existing email project's MySQL/MariaDB database).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=email
DB_USERNAME=root
DB_PASSWORD=

# Separate database used by the test suite (Rails erases it on every run).
DB_DATABASE_TEST=email_test
