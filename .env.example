# Copy to .env and fill in. .env is gitignored; this file is the documentation.

# --- Primary database: the email project's MySQL/MariaDB ---
DB_HOST=ltvb.nl
DB_PORT=3306
DB_DATABASE=email.lucasvanbriemen.nl
DB_USERNAME=
DB_PASSWORD=

# Separate database used by the test suite (Rails erases it on every run).
DB_DATABASE_TEST=email_test

# --- Secondary database: the music project's, being rewritten into this app ---
# On the same MySQL instance as the primary, so host/port/credentials are
# inherited from the DB_* values above. Set MUSIC_DB_HOST, MUSIC_DB_PORT,
# MUSIC_DB_USERNAME or MUSIC_DB_PASSWORD only to override one of them.
MUSIC_DB_DATABASE=music
# Not `music_test`: that is the database the music project's own suite erases.
MUSIC_DB_DATABASE_TEST=all_in_one_music_test

# --- Optional ---
# Web threads per process (also sizes the music connection pool).
# RAILS_MAX_THREADS=3
# Threads the job worker gives IMAP fetching; sizes the primary pool.
# IMAP_FETCH_CONCURRENCY=20
# Where the shared UI components live, if not auto-discovered.
# SHARED_UI_PATH=
