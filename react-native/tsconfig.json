{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // The RN base config targets a native runtime with no DOM. The web entry
    // and vite.config.ts need browser and Node globals respectively.
    "lib": ["ESNext", "DOM"],
    "types": ["node", "jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
