<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Sandbox is deliberately off.

	  The Code page edits files anywhere the user points it, and its terminal
	  forks a real shell through node-pty. A sandboxed app can do neither: it
	  gets read-only access to files chosen through an open panel, and it cannot
	  fork a pty at all. The sandbox is required to ship on the App Store and
	  optional everywhere else, and this app is distributed directly.

	  Notarisation requires the Hardened Runtime instead, which is on (see
	  ENABLE_HARDENED_RUNTIME in the build settings) with the exceptions below.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
