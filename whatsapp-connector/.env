# Digits only, country code first (e.g. 31612345678). When set, the bridge
# requests a pairing code on first boot and logs it; type it into
# WhatsApp > Linked devices > Link with phone number.
PHONE_NUMBER=31683237662

# Where to POST events. Leave empty to log events to stdout instead.
WEBHOOK_URL=

# Shared with Rails. Sent as X-Bridge-Secret on webhooks, required on API calls.
BRIDGE_SECRET=

# Defaults
# PORT=4002
# HOST=127.0.0.1
# AUTH_DIR=../storage/whatsapp/auth
# LOG_LEVEL=info
