<% content_for :title, "Mail" %>

<div class="email-page" data-controller="email-page">
  <div class="email-listing">

    <%= form_with url: request.path, method: :get, class: "email-search", builder: CustomFormBuilder do |form| %>
      <%= form.text_field :q, value: params[:q], label: "Search emails" %>
      <%= form.submit "Search" %>
    <% end %>

    <% @emails.each do |email| %>
      <%= render partial: "email-button", locals: { email: email } %>
    <% end %>

    <div class="pagination">
      <%= paginate @emails %>
    </div>
  </div>

  <div class="email-content placeholder-content" data-email-page-target="content">
    Select an email to view its content.
  </div>
</div>
