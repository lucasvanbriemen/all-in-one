<button class="email-item" data-action="email-page#select" data-email-page-id-param="<%= email.id %>">
  <img src="<%= email.sender.image_url %>" loading="lazy">
  <div class="email-info">
    <h3 class="subject"><%= email.subject %></h3>
    <div class="meta">
      <span class="sender"><%= email.sender.name %></span>
      <span class="separator"></span>
      <span class="timestamp"><%= time_ago_in_words(email.created_at) %></span>
    </div>
  </div>
</button>